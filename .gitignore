# === Environments & Dependencies ===
venv/
.venv/
env/
*/venv/
*/.venv/
**/venv/
**/.venv/

# === Python Cache & Artifacts ===
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# === Environment Variables & Secrets ===
.env
*.env
!.env.example
ai_scanner/.env

# === Local Persistent Storage & Databases ===
ai_scanner/data/raw/*
